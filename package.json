{
  "name": "recade-monorepo",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test && vitest run",
    "type-check": "turbo run type-check",
    "build:docs": "node scripts/build-docs.mjs",
    "build:site": "node scripts/build-docs.mjs && node scripts/build-site.mjs",
    "test:site": "vitest run"
  },
  "devDependencies": {
    "marked": "^18.0.14",
    "turbo": "^2.11.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  }
}
